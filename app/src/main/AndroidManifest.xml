<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  【修复 TTS】queries 声明：Android 11+ 必需                 -->
    <!--  不声明则 PackageManager 无法发现 TTS 引擎包名             -->
    <!--  这是 OPPO ColorOS TTS 初始化失败的根因之一                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <queries>
        <!-- Google TTS -->
        <package android:name="com.google.android.tts" />
        <!-- 科大讯飞（新版） -->
        <package android:name="com.iflytek.speechsuite" />
        <!-- 科大讯飞（旧版） -->
        <package android:name="com.iflytek.tts" />
        <!-- 百度语音 -->
        <package android:name="com.baidu.duersdk.opensdk" />
        <!-- 三星 TTS -->
        <package android:name="com.samsung.SMT" />
        <!-- 华为语音 -->
        <package android:name="com.huawei.hiai" />
        <!-- vivo TTS -->
        <package android:name="com.vivo.tts" />
        <!-- ColorOS / HeyTap TTS -->
        <package android:name="com.coloros.speech.tts" />
        <package android:name="com.heytap.speech.tts" />

        <!-- TTS 数据检查 Intent -->
        <intent>
            <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
        </intent>
        <!-- TTS 数据安装 Intent -->
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
        <!-- 应用商店（引导安装 Google TTS） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- 浏览器（兜底下载链接） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- 定位权限 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 音频与语音权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 【修复 TTS】部分国产 ROM 需要此权限进行跨用户 TTS 调用 -->
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:ignore="ProtectedPermissions" />

    <!-- 摄像头权限（避障用） -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- WiFi状态改变权限，用于网络定位 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- A-GPS模块调用，卫星定位加速 -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <!-- 蓝牙权限，用于导航组件蓝牙连接提醒和蓝牙TTS播报 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 保持屏幕常亮，导航状态中需要 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 写设备缓存，用于导航问题排查 -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 前台服务权限（Android 9+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuideRunningFortheBlind"
        tools:targetApi="34">

        <!-- 高德地图 API Key -->
        <!-- 【修复】占位符改为实际值，在 local.properties 中定义 MAPS_API_KEY 后自动替换 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${MAPS_API_KEY}" />

        <!-- 【修复 TTS】必需：声明应用使用 TTS 功能 -->
        <meta-data
            android:name="android.speech.tts"
            android:value="com.example.guiderunningfortheblind.speech.GuideTtsService" />

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 【修复 TTS】引导页：TTS 设置与安装引导 -->
        <activity
            android:name=".speech.TtsSetupGuideActivity"
            android:exported="false"
            android:label="语音引擎设置"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GuideRunningFortheBlind" />

        <!-- 高德导航组件 Activity，步行导航必需 -->
        <activity
            android:name="com.amap.api.navi.AmapRouteActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|navigation"
            android:theme="@android:style/Theme.NoTitleBar" />

        <!-- 原有前台服务 -->
        <service
            android:name=".service.RunningService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|camera" />

        <!-- 高德定位服务 -->
        <service android:name="com.amap.api.location.APSService" />

    </application>

    <!-- OPPO 必需：忽略电池优化，防止后台被杀 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

</manifest>
